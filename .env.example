# Audit Bench Environment Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PORT=8000

# Database
# Local SQLite default (for immediate zero-dependency testing) or PostgreSQL for production:
DATABASE_URL=sqlite:///./audit_bench.db
# PostgreSQL production string: postgresql+psycopg://audit_bench:audit_bench_secure_pwd@localhost:5432/audit_bench

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# GitHub App Integration
GITHUB_APP_ID=100001
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=development_webhook_secret_key_8820
GITHUB_CLIENT_ID=Iv1.mock_client_id
GITHUB_CLIENT_SECRET=mock_client_secret

# Security & JWT Auth
JWT_SECRET=super_secret_jwt_key_audit_bench_dev_32_bytes_len
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scanners Configuration
SEMGREP_PATH=semgrep
TRIVY_PATH=trivy
GITLEAKS_PATH=gitleaks
SCANNER_TIMEOUT_SECONDS=300
